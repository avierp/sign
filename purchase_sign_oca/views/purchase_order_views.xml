<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button type="object" name="action_view_sign_requests" class="oe_stat_button" icon="fa-file-text-o" invisible="sign_request_count==0" groups="sign_oca.sign_oca_group_user">
                    <field name="sign_request_count" widget="statinfo" />
                </button>
            </div>
        </field>
    </record>
</odoo>
